name: Build Installers

# From the gjwgit/fluttertmpl Copier template. The jobs are in the
# template's reusable installers.yaml, pinned here to the template
# version this app was last updated to, so `make update` moves both
# together.
#
# The name and the push trigger stay here: installers/update.sh and `make
# ginfo` find the runs by the "Build Installers" name, and the jobs test
# the head commit message ("Bump version", "build deb", ...).

on:
  push:
    branches:
      - dev
      - build
      - installers

jobs:
  installers:
    uses: gjwgit/fluttertmpl/.github/workflows/installers.yaml@{{ _copier_answers._commit }}

    # The signing secrets each job skips without, and DART_SECRETS, the
    # app's build.secrets from .copier-answers.yml as a JSON object for
    # the scramble step. A secret's value must not hold a double quote.

    secrets:
{% for name in ['AC_API_ISSUER_ID', 'AC_API_KEY', 'AC_API_KEY_ID', 'ANDROID_KEYSTORE', 'ANDROID_KEYSTORE_PWD', 'ANDROID_KEY_ALIAS', 'ANDROID_KEY_PWD', 'IOS_CERTIFICATE', 'IOS_CERTIFICATE_PWD', 'IOS_PROVISION_PROFILE', 'MACOS_DEVELOPER_ID_CERT', 'MACOS_DEVELOPER_ID_CERT_PWD', 'MACOS_DEVELOPER_ID_PROFILE', 'MACOS_KEYCHAIN_PWD'] %}
      {{ name }}: ${{ '{{' }} secrets.{{ name }} }}
{% endfor %}
{% if build.get('secrets') %}
      DART_SECRETS: >-
        { {% for name in build.secrets %}"{{ name }}": "${{ '{{' }} secrets.{{ name }} }}"{{ ", " if not loop.last else "" }}{% endfor %} }
{% endif %}
