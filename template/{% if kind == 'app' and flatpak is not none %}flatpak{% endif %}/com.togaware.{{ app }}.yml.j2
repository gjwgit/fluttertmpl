# {{ name }} as a Flatpak.
#
# From the gjwgit/fluttertmpl Copier template. Values come from
# .copier-answers.yml. Local edits are kept by `copier update`, which
# merges template changes in.
#
# 20261029 gjw Wraps the Flutter release bundle built on the host (`make
# flatpak` builds it first, as the installers workflow does) in the GNOME
# runtime. Build with `make flatpak`, which builds outside the project
# (see the Makefile), then run with `flatpak run com.togaware.{{ app }}`.

id: com.togaware.{{ app }}
runtime: org.gnome.Platform
runtime-version: '49'
sdk: org.gnome.Sdk
command: {{ app }}

finish-args:
  - --share=ipc
  - --socket=wayland
  - --socket=fallback-x11
  - --device=dri

  # The Pod, and the fonts google_fonts fetches.

  - --share=network

  # solidpod keeps the security key through flutter_secure_storage, which
  # on GNU/Linux is libsecret talking to the keyring over this name. The
  # snap needs password-manager-service connected by hand; here it is
  # granted by the manifest.

  - --talk-name=org.freedesktop.secrets
{% if flatpak.get('finish-args') %}

  # From .copier-answers.yml flatpak.finish-args.

{% for arg in flatpak['finish-args'] %}
  - {{ arg }}
{% endfor %}
{% endif %}
{% if flatpak.get('modules') %}

# Only the libraries the app needs at runtime are kept from the modules
# built from source.

cleanup:
  - /include
  - /lib/pkgconfig
  - /share/man
  - '*.la'
  - '*.a'
{% endif %}

modules:
{% if flatpak.get('modules') %}

  # From .copier-answers.yml flatpak.modules, each a file in flatpak/
  # holding a module that flatpak-builder builds before the app.

{% for module in flatpak.modules %}
  - {{ module }}
{% endfor %}
{% endif %}

  # The app: the Flutter bundle as built, under /app/{{ app }}, since the
  # executable finds its lib/ and data/ beside itself.
  #
  # 20261030 gjw The AppStream release is the pubspec version, written in
  # at build time, so it cannot go stale as a hand-kept one did.

  - name: {{ app }}
    buildsystem: simple
    build-commands:
      - mkdir -p /app/{{ app }} /app/bin
      - cp -r bundle/. /app/{{ app }}/
      - ln -s /app/{{ app }}/{{ app }} /app/bin/{{ app }}
      - install -Dm644 com.togaware.{{ app }}.desktop
          /app/share/applications/com.togaware.{{ app }}.desktop
      - sed -e "s/@VERSION@/$(grep '^version:' pubspec.yaml | cut -d' ' -f2 | cut -d+ -f1)/"
          -e "s/@DATE@/$(date +%F)/" com.togaware.{{ app }}.metainfo.xml
          > com.togaware.{{ app }}.metainfo.xml.new
      - install -Dm644 com.togaware.{{ app }}.metainfo.xml.new
          /app/share/metainfo/com.togaware.{{ app }}.metainfo.xml
      - install -Dm644 icon.png
          /app/share/icons/hicolor/512x512/apps/com.togaware.{{ app }}.png
    sources:
      - type: dir
        path: ../build/linux/x64/release/bundle
        dest: bundle
      - type: file
        path: com.togaware.{{ app }}.desktop
      - type: file
        path: com.togaware.{{ app }}.metainfo.xml
      - type: file
        path: ../pubspec.yaml

      # A Flatpak icon must be square, and no larger than the 512x512
      # folder it installs into.

      - type: file
        path: ../{{ flatpak.get('icon', 'snap/gui/icon.png') }}
        dest-filename: icon.png
